#!/bin/sh
# .githooks/commit-msg — every commit names the backlog item it serves.
#
# DoD §1b rule 1: all work refers to a backlog item. This is the enforcement.
# Without it the rule is a thing you must remember while you are busy, which is
# the shape this repo has now rejected five times (BUG-004's "flip the mic
# last", BUG-014's fixture isolation, the no-chaining rule that needed a
# PreToolUse hook, BUG-020's baked state paths, BUG-019's migration hazard).
#
# THE FORMAT
#
#   <TYPE>#<number>: <subject>
#
#   BUG#20: a refused pull exits non-zero
#   FEATURE#3: the gate renders as a pipeline
#   TASK#1: move the lcm checklist into the DoD
#
# TYPE is BUG, FEATURE or TASK — the three lifecycle ID namespaces. The number
# is the item's number. Everything after the colon is an ordinary subject line.
#
# WHAT IS ALLOWED THROUGH, and why each is not a loophole:
#
#   merge commits    — git generates the message; there is no single item.
#   revert commits   — git generates "Revert \"<original>\"", and the original
#                      already named its item.
#   fixup!/squash!   — these are rebase instructions, not final messages. The
#                      commit they fold into was checked when it was written.
#   comment lines    — the template git appends is not the subject.
#
# It reads the SUBJECT ONLY (first non-comment, non-blank line). A body may say
# anything.
#
# FAILS CLOSED. An unreadable or absent message file is a rejection, not a pass.
# A gate that cannot read its input has not checked anything, and "could not
# check" must never render as "passed" — the lesson BUG-018 taught twice.

set -u

msg_file="${1:-}"

if [ -z "$msg_file" ] || [ ! -r "$msg_file" ]; then
  echo "commit-msg: cannot read the commit message file — refusing." >&2
  echo "  A gate that cannot read its input has checked nothing." >&2
  exit 1
fi

# First line that is neither blank nor a git comment.
subject="$(grep -vE '^\s*#' "$msg_file" | grep -vE '^[[:space:]]*$' | head -1)"

if [ -z "$subject" ]; then
  echo "commit-msg: the commit message is empty — refusing." >&2
  exit 1
fi

case "$subject" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*|"amend!"*)
    exit 0
    ;;
esac

# THE ROOT COMMIT is exempt. A repository's first commit creates the repository;
# it is not work on an item, and it CANNOT name one because no backlog exists
# yet. Found immediately: this hook ships into every bootstrapped project and
# `new-project.sh` commits the initial tree, so without this the very first
# thing a new project does is fail.
#
# Narrow on purpose — only the commit with no parent, which happens once per
# repository ever.
if ! git rev-parse --verify -q HEAD >/dev/null 2>&1; then
  exit 0
fi

if printf '%s' "$subject" | grep -qE '^(BUG|FEATURE|TASK)#[0-9]+: .+'; then
  exit 0
fi

cat >&2 <<EOF
commit-msg: REJECTED — the subject must start with its backlog item.

  got:      $subject

  expected: <TYPE>#<number>: <subject>

              BUG#20: a refused pull exits non-zero
              FEATURE#3: the gate renders as a pipeline
              TASK#1: move the lcm checklist into the DoD

  TYPE is BUG, FEATURE or TASK.

Every change refers to a backlog item (docs/DoD.md §1b rule 1). If this work has
no item yet, it is not ready to commit: add a row under docs/backlog/, promote it
to docs/doing/, then commit.

Merge, revert and fixup!/squash! commits are exempt.
EOF
exit 1
