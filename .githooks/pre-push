#!/bin/sh
# Pre-push hook: block push if any of these fail:
#   - Security (gitleaks + Semgrep + osv-scanner — see docs/SECURITY.md)
#   - Build (tsc / compile)
#   - Lint (--max-warnings ratcheted)
#   - Format check (Prettier)
#   - Tests + coverage (per docs/DoD.md §3)
#   - IaC validate (cdk synth / terraform / helm — see docs/INFRASTRUCTURE.md)
#   - Project-specific guards (see .githooks/pre-push-project)
#
# This file is tracked at .githooks/pre-push, but being tracked is NOT the same
# as being active: git only runs it when `core.hooksPath` points here, and that
# is repo-LOCAL config a fresh clone does not have. This header used to claim a
# `postinstall` wires it up; there is no root package.json, so nothing did, and
# a 12-commit push went out ungated while this gate was run by hand and reported
# green (A-22).
#
# `arm_gate` (scripts/lib/gate.sh) now sets it from paths that already run on
# every wake — the activity feed and `blueprint drift`. Verify with
# `git config --get core.hooksPath`; empty means this file is decoration.
#
# This is the BLUEPRINT version: generic checks only. Project-specific guards
# (placeholder injection, asset invariants, release-notes guard, etc.) live
# in .githooks/pre-push-project and are sourced below if present.

set -e

echo "🔒 Pre-push: security + build + lint + tests..."

# --- What is actually being pushed (A-03) ------------------------------------
# git feeds a pre-push hook one line per ref on STDIN:
#     <local_ref> <local_sha> <remote_ref> <remote_sha>
# Read it ONCE, here, into a variable. Nothing further down consumes stdin, and
# a later step that did would otherwise silently eat the ref list.
#
# This exists because the secret scan used to run `gitleaks protect --staged`,
# which scans the INDEX — empty at pre-push time, since the commit is already
# made. Verified against a real gitleaks with a real secret in the outgoing
# commit: "0 commits scanned, ~0 bytes ... no leaks found". The gate that
# CLAUDE.md §Security calls blocking was a no-op in the normal flow.
_PUSH_REFS="$(cat || true)"
_ZERO=0000000000000000000000000000000000000000

# The DESTINATION remote, which git passes as $1. It matters: "already
# published" has to mean "already on the remote I am pushing to", not "on any
# remote I happen to have configured. A commit sitting on a private mirror is
# still a first disclosure when it goes to the public one.
_PUSH_REMOTE="${1:-}"

# push_log_opts — prints the `git log` selector covering everything about to be
# published, or nothing when there is nothing to scan. Handles the three shapes
# git can hand us:
#   normal update  remote_sha..local_sha
#   new branch     remote_sha is all-zero and is NOT a resolvable revision, so
#                  `000..local` would make the scan ERROR. Subtract only THIS
#                  remote's tracking refs.
#   deletion       local_sha is all-zero: nothing is published, so nothing to
#                  scan — and a range built from it would be nonsense.
#
# A NEW ref is scanned in FULL — everything reachable from the local sha, with
# nothing subtracted. Two rejected attempts are worth recording, because the
# obvious optimisations are both unsafe:
#
#   `--not --remotes`             subtracts EVERY configured remote, so a
#                                 commit sitting on a private mirror was
#                                 skipped on its first push to a public one.
#   `--not --remotes=<dest>`      still only a namespace selector over
#                                 refs/remotes/<dest>/*. It never asks the
#                                 destination what it actually has, and it does
#                                 not interpret an unusual fetch refspec. A
#                                 stale-ahead, phantom, or repurposed local ref
#                                 in that namespace subtracts commits the
#                                 destination need not contain — an UNDER-scan.
#
# git gives the hook no server-authenticated view of what a new destination ref
# already holds, so there is nothing trustworthy to subtract. Over-scanning
# costs time; under-scanning ships secrets. For an updated ref the old sha
# comes from git itself on stdin, so `remote..local` is authoritative there.
push_log_opts() {
  echo "$_PUSH_REFS" | while read -r _lref _lsha _rref _rsha; do
    [ -n "${_lsha:-}" ] || continue
    [ "$_lsha" = "$_ZERO" ] && continue
    if [ "${_rsha:-$_ZERO}" = "$_ZERO" ]; then
      echo "$_lsha"
    else
      echo "$_rsha..$_lsha"
    fi
  done
}

# --- Security: gitleaks + Semgrep + osv-scanner (docs/SECURITY.md cross-recipe rules) ---
# All three are skipped with a warning if the binary isn't installed locally
# — CI re-runs them as a backstop. This keeps a fresh clone from being
# blocked on day 1 while still nudging the developer to install them.

if command -v gitleaks >/dev/null 2>&1; then
  echo "  → Secret scan (gitleaks)..."
  # Same exit-code discipline as the semgrep step below: gitleaks exits 1 when
  # it FINDS a leak and >=2 when it could not run. Treating both as "found a
  # secret" is misleading in one direction and, worse, an operator who learns to
  # shrug off spurious failures will shrug off a real one.
  _gl_out="$(mktemp)"
  _gl_rc=0
  _gl_ranges="$(push_log_opts)"

  if [ -z "$_gl_ranges" ]; then
    if [ -n "$_PUSH_REFS" ]; then
      # Every ref was a deletion — nothing is being published.
      echo "     nothing published (branch deletion) — no content to scan."
    else
      # No ref lines: the hook was invoked by hand, by CI, or by a fixture
      # rehearsing the gate. Scanning nothing here would turn "run the gate
      # manually" into a hole, so fall back to the outgoing commits against the
      # upstream, and to the whole history when there is no upstream to
      # subtract. Never silently skip.
      _gl_up="$(git rev-parse --abbrev-ref '@{u}' 2>/dev/null || true)"
      if [ -n "$_gl_up" ]; then
        _gl_ranges="$_gl_up..HEAD"
      else
        _gl_ranges="--all"
      fi
      echo "     no ref info on stdin — scanning $_gl_ranges"
    fi
  fi

  # Same exit-code discipline as semgrep below (BUG-003): 1 means gitleaks
  # FOUND something, >=2 means it could not run. They are different failures
  # and are reported differently — an operator who learns to shrug off a
  # spurious one will shrug off a real one.
  # The loop runs in a subshell, so the exit status is passed back through the
  # output file rather than a variable — one range per line, any of which may
  # find something.
  # BOUNDED, and it fails closed when the bound is hit (A-03 R3-F2). A new ref
  # is scanned in full — the only security-safe choice with what a pre-push hook
  # knows — but "full" is unbounded, and the ≤30s gate ceiling in CLAUDE.md is
  # unconditional. Those two cannot both be satisfied silently, so the conflict
  # is resolved explicitly: cap the local scan, and if it does not finish, BLOCK
  # and say the scan was incomplete. An unfinished scan is not a clean one.
  # Push again after `--log-opts` narrows, or let CI do the full history.
  _gl_budget="${GITLEAKS_TIMEOUT_SECONDS:-20}"
  printf '%s\n' "$_gl_ranges" | while IFS= read -r _gl_range; do
    [ -n "$_gl_range" ] || continue
    if command -v timeout >/dev/null 2>&1; then
      timeout "$_gl_budget" gitleaks detect --redact --no-banner --log-opts="$_gl_range" >>"$_gl_out" 2>&1 \
        || echo "GITLEAKS_RC=$?" >>"$_gl_out"
    else
      gitleaks detect --redact --no-banner --log-opts="$_gl_range" >>"$_gl_out" 2>&1 \
        || echo "GITLEAKS_RC=$?" >>"$_gl_out"
    fi
  done
  _gl_rc=0
  if grep -q '^GITLEAKS_RC=1$' "$_gl_out" 2>/dev/null; then
    _gl_rc=1
  elif grep -q '^GITLEAKS_RC=' "$_gl_out" 2>/dev/null; then
    _gl_rc="$(grep -m1 '^GITLEAKS_RC=' "$_gl_out" | cut -d= -f2)"
  fi

  if [ "$_gl_rc" -eq 1 ]; then
    tail -30 "$_gl_out"; rm -f "$_gl_out"
    echo "❌ gitleaks found a secret in the commits you are pushing."
    echo "   Rotate the credential FIRST, then rewrite the history that carries it."
    echo "   A leaked secret is compromised the moment it lands on origin, and"
    echo "   removing the commit does not un-leak it."
    exit 1
  elif [ "$_gl_rc" -eq 124 ]; then
    tail -10 "$_gl_out"; rm -f "$_gl_out"
    echo "❌ gitleaks did not finish within ${_gl_budget}s — the scan is INCOMPLETE."
    echo "   Blocked, because an unfinished scan is not a clean one. This is the"
    echo "   documented edge of the ≤30s pre-push budget (DoD §4): a brand-new"
    echo "   ref is scanned over its whole history, which is unbounded."
    echo "   Options: raise GITLEAKS_TIMEOUT_SECONDS deliberately for this push,"
    echo "   push a smaller range first, or let CI scan the full history."
    exit 1
  elif [ "$_gl_rc" -ne 0 ]; then
    tail -30 "$_gl_out"; rm -f "$_gl_out"
    echo "❌ gitleaks could not complete (exit $_gl_rc) — the secret gate did NOT run."
    echo "   This is a TOOL failure, not a clean scan, so the push is blocked."
    exit 1
  fi
  rm -f "$_gl_out"
else
  echo "  ⚠ gitleaks not installed locally — secret scan skipped (CI will catch it)."
  echo "     Install: brew bundle  (from repo root, uses ./Brewfile)"
fi

if command -v semgrep >/dev/null 2>&1; then
  echo "  → SAST (semgrep p/owasp-top-ten)..."
  # p/owasp-top-ten is the conservative baseline; projects can add packs in
  # .githooks/pre-push-project. NOTE: `p/` configs are fetched from the Semgrep
  # registry (cached under ~/.semgrep), so this is NOT a purely offline step.
  #
  # CLASSIFY FROM JSON, NOT THE EXIT CODE. A finding and a crash are DIFFERENT
  # outcomes and must never be confused — a broken scanner reported as a
  # vulnerability teaches operators to shrug off the gate. The exit code cannot
  # tell them apart: semgrep exits 1 for findings AND for some fatal errors
  # (an unwritable ~/.semgrep dir exits 1 with a traceback and no JSON — Codex
  # R-3). So:
  #   - FINDINGS come from `.results[]` in --json output. An OSError produces no
  #     results, so it can never be misread as a finding.
  #   - COMPLETENESS comes from the exit code, and ONLY exit 0 proves it. Any
  #     non-zero exit with zero results means the scan is not proven complete
  #     (exit >=2 is the io_uring/memlock crash; exit 1 is ambiguous), so "0
  #     findings" cannot be trusted and we retry single-job, then fail closed.
  # jq is required: without a reliable parser we would be back to guessing, which
  # is the exact defect this fixes — so a missing jq fails closed, not open.
  if ! command -v jq >/dev/null 2>&1; then
    echo "❌ jq is required to classify semgrep output reliably, but is not installed."
    echo "   Install jq (brew bundle, or apt/dnf install jq). Blocking rather than"
    echo "   guessing whether a non-zero semgrep exit is a finding or a crash."
    exit 1
  fi

  _sg_json="$(mktemp)"; _sg_err="$(mktemp)"

  # $1 = extra args (word-split intentionally, e.g. "--jobs 1"); sets _sg_class
  # (finding|incomplete|clean), _sg_findings, _sg_rc.
  #
  # A "clean" verdict is the strongest claim this gate makes, so it demands the
  # most evidence: semgrep exited 0 AND emitted a well-formed `.results` ARRAY
  # AND that array is empty. Anything weaker is incomplete, never clean:
  #   - invalid JSON (crash before output — the OSError class);
  #   - `.results` missing or not an array (wrong/partial schema) — NOT coerced
  #     to zero findings, which would fail open;
  #   - a NON-ZERO exit with zero results — exit 1 is not semgrep's clean exit,
  #     so "0 results" there is not a proven-complete scan (Codex R2-1).
  # Only the exit code proves completeness; only the results array proves
  # findings. Neither is inferred from the other.
  _sg_classify() {
    _sg_rc=0
    # shellcheck disable=SC2086
    semgrep $1 --json \
      --config=p/owasp-top-ten \
      --severity=WARNING --severity=ERROR \
      --timeout=20 --metrics=off --quiet \
      . >"$_sg_json" 2>"$_sg_err" || _sg_rc=$?
    # Require a well-formed results ARRAY. `jq -e` is false/non-zero when the
    # JSON is invalid, or `.results` is missing / not an array — all incomplete.
    if ! jq -e '(.results | type) == "array"' "$_sg_json" >/dev/null 2>&1; then
      _sg_class=incomplete; return
    fi
    _sg_findings="$(jq '.results | length' "$_sg_json")"
    if [ "${_sg_findings:-0}" -gt 0 ]; then
      _sg_class=finding                       # real results, regardless of exit
    elif [ "$_sg_rc" -eq 0 ]; then
      _sg_class=clean                          # zero results AND a clean exit
    else
      _sg_class=incomplete                     # zero results but a non-zero exit
    fi
  }

  _sg_classify ""
  if [ "$_sg_class" = "incomplete" ]; then
    # Retry single-job. --jobs 1 avoids the io_uring parallelism that crashes
    # under a low RLIMIT_MEMLOCK (8 MB is a common Linux default) even with tens
    # of GB free — a strictly better retry than repeating the identical command.
    echo "  ⚠ semgrep did not complete (exit $_sg_rc) — retrying single-job..."
    _sg_classify "--jobs 1"
  fi

  if [ "$_sg_class" = "finding" ]; then
    jq -r '.results[] | "  \(.check_id)  \(.path):\(.start.line)"' "$_sg_json" 2>/dev/null | head -40
    rm -f "$_sg_json" "$_sg_err"
    echo "❌ Semgrep found ${_sg_findings} WARNING+ finding(s)."
    echo "   Fix the finding, or suppress with '// nosemgrep: <rule-id> — <justification>'"
    echo "   naming the threat-model entry in project_config_security.md that makes it safe."
    exit 1
  elif [ "$_sg_class" = "incomplete" ]; then
    tail -20 "$_sg_err"
    rm -f "$_sg_json" "$_sg_err"
    echo "❌ semgrep could not complete (exit $_sg_rc) — the SAST gate did NOT run."
    echo "   This is a TOOL failure, not a clean scan, so the push is blocked."
    echo "   Common causes: an unwritable ~/.semgrep dir, or registry/network"
    echo "   unavailable for the p/ pack. Re-run, or set SEMGREP_RULES to a local"
    echo "   ruleset if you need to work offline."
    exit 1
  fi
  rm -f "$_sg_json" "$_sg_err"
else
  echo "  ⚠ semgrep not installed locally — SAST skipped (CI will catch it)."
  echo "     Install: brew bundle  (from repo root, uses ./Brewfile)"
fi

if command -v osv-scanner >/dev/null 2>&1; then
  echo "  → SCA (osv-scanner over lockfiles)..."
  # Scan every lockfile in the repo. osv-scanner v2 exits non-zero BOTH on a real
  # finding AND when there are no lockfiles at all ("No package sources found",
  # exit 128) — so a repo without lockfiles (this template before bootstrap, or a
  # workspace not yet `npm install`ed) must be a clean no-op, not a CVE. Only a
  # non-zero exit WITH actual scan output is a failure.
  # `if assign=$(cmd); then` keeps the failing exit OUT of `set -e`'s reach (a bare
  # `osv_out=$(failing)` aborts the hook under /bin/sh before we can inspect it).
  if osv_out=$(osv-scanner scan --recursive . 2>&1); then
    :  # clean — no vulnerabilities
  elif printf '%s' "$osv_out" | grep -q "No package sources found"; then
    :  # no lockfiles in this repo (template / pre-bootstrap) — nothing to scan
  else
    printf '%s\n' "$osv_out" | tail -20
    echo "❌ osv-scanner found a CVE in a dependency."
    echo "   Upgrade or pin to a known-good version. Track lower-severity CVEs"
    echo "   in docs/config/findings.md with a planned upgrade date."
    exit 1
  fi
else
  echo "  ⚠ osv-scanner not installed locally — SCA skipped (CI will catch it)."
  echo "     Install: brew bundle  (from repo root, uses ./Brewfile)"
fi

# Adjust these paths / commands to match your project's workspaces.
# {{PROJECT_NAME}}: edit this block during bootstrap to reflect your layout.

# Each workspace runs the same gate order (per docs/DoD.md §4):
#   build → lint → format:check → test:coverage → project guards
#
# Required npm scripts per workspace:
#   - build         (e.g. tsc)
#   - lint          (eslint with ratcheted --max-warnings)
#   - format:check  (prettier --check . — fails if anything unformatted)
#   - test:coverage (test runner + coverage; fails if project's
#                    greenfield ≥90% / brownfield ≥70% threshold not met,
#                    per project_config_dod.md)

# --- Backend (if present) ---
if [ -d backend ]; then
  echo "  → Backend build..."
  ( cd backend && npm run build ) || { echo "❌ Backend build failed."; exit 1; }

  echo "  → Backend lint..."
  ( cd backend && npm run lint ) || { echo "❌ Backend lint exceeded --max-warnings threshold."; exit 1; }

  echo "  → Backend format check (Prettier)..."
  ( cd backend && npm run format:check ) || { echo "❌ Backend has unformatted files. Run 'npm run format' in backend/ and recommit."; exit 1; }

  echo "  → Backend tests + coverage..."
  ( cd backend && npm run test:coverage ) || { echo "❌ Backend tests failed or coverage below threshold (see project_config_dod.md)."; exit 1; }
fi

# --- Frontend (if present) ---
if [ -d frontend ]; then
  echo "  → Frontend lint..."
  ( cd frontend && npm run lint ) || { echo "❌ Frontend lint exceeded --max-warnings threshold."; exit 1; }

  echo "  → Frontend format check (Prettier)..."
  ( cd frontend && npm run format:check ) || { echo "❌ Frontend has unformatted files. Run 'npm run format' in frontend/ and recommit."; exit 1; }

  echo "  → Frontend tests + coverage..."
  ( cd frontend && npm run test:coverage ) || { echo "❌ Frontend tests failed or coverage below threshold (see project_config_dod.md)."; exit 1; }
fi

# --- IaC validate: cdk synth / terraform validate / helm lint (docs/INFRASTRUCTURE.md cross-recipe rules) ---
# Each step runs only if the corresponding infra layout is present and the
# tool is installed. Missing tool prints a hint and skips — CI re-runs as
# the backstop. Same UX pattern as the security gate above.

if [ -d infra ]; then
  # Recipe A — CDK (TypeScript): detect by infra/cdk.json
  if [ -f infra/cdk.json ]; then
    if command -v cdk >/dev/null 2>&1; then
      echo "  → IaC synth (cdk)..."
      ( cd infra && cdk synth --quiet >/dev/null ) || {
        echo "❌ cdk synth failed. Fix the IaC errors before pushing."
        echo "   Run 'cd infra && cdk synth' locally to see the full output."
        exit 1
      }
    else
      echo "  ⚠ cdk not installed locally — IaC synth skipped (CI will catch it)."
      echo "     Install: brew bundle  (from repo root, uses ./Brewfile)"
    fi
  fi

  # Recipe B — Terraform: detect by any infra/**/*.tf
  if ls infra/**/*.tf >/dev/null 2>&1 || ls infra/*.tf >/dev/null 2>&1; then
    if command -v terraform >/dev/null 2>&1; then
      echo "  → IaC validate (terraform)..."
      ( cd infra && terraform fmt -check -recursive >/dev/null ) || {
        echo "❌ Terraform files are unformatted. Run 'terraform fmt -recursive' in infra/ and recommit."
        exit 1
      }
      # terraform validate needs init; skip if .terraform/ isn't present (CI does the deeper validate)
      if [ -d infra/.terraform ]; then
        ( cd infra && terraform validate >/dev/null ) || {
          echo "❌ terraform validate failed. Fix the IaC errors before pushing."
          exit 1
        }
      else
        echo "    (skipping terraform validate — run 'terraform init' in infra/ to enable locally)"
      fi
    else
      echo "  ⚠ terraform not installed locally — IaC validate skipped (CI will catch it)."
      echo "     Install: brew bundle  (from repo root, uses ./Brewfile)"
    fi
  fi

  # Recipe C — Helm charts: detect by infra/charts/*/Chart.yaml
  if ls infra/charts/*/Chart.yaml >/dev/null 2>&1; then
    if command -v helm >/dev/null 2>&1; then
      echo "  → IaC lint (helm)..."
      for chart in infra/charts/*/; do
        helm lint "$chart" >/dev/null || {
          echo "❌ helm lint failed on $chart"
          exit 1
        }
      done
    else
      echo "  ⚠ helm not installed locally — chart lint skipped (CI will catch it)."
      echo "     Install: brew bundle  (from repo root, uses ./Brewfile)"
    fi
  fi
fi

# --- .claude/settings.json host-path guard (generic struct2flow rule) ---
# The COMMITTED settings.json must be host-agnostic — it travels with the
# repo to every machine and (when public) every fork. Absolute paths to a
# specific machine's home directory leak via Claude Code's auto-allowlist
# every time the agent runs a Bash command with such a path. They belong
# in .claude/settings.local.json (gitignored), never in settings.json.
#
# Three drift cycles in a row landed paths like /Users/<name>/.ssh,
# /Users/<name>/sources/, /Users/<name>/Library/Containers/... in
# settings.json. This guard blocks any future occurrence.
#
# To allow-list a legitimate generic path that happens to contain /Users
# or /home as a literal substring (rare), add a comment line above the
# entry: this grep is line-based and won't match across lines.
echo "  → .claude/settings.json host-path guard..."
if [ -f .claude/settings.json ]; then
  HOST_PATHS=$(grep -nE '/(Users|home)/[A-Za-z0-9_.-]+/' .claude/settings.json || true)
  if [ -n "$HOST_PATHS" ]; then
    echo "❌ .claude/settings.json contains host-specific paths."
    echo "   Move them to .claude/settings.local.json (gitignored) — settings.json"
    echo "   is committed and must stay host-agnostic."
    echo "$HOST_PATHS" | sed 's/^/     /'
    exit 1
  fi
fi

# --- Project-specific guards (sourced if present) ---
# Add your project's invariants in .githooks/pre-push-project:
#   - placeholder / config drift guards
#   - asset / favicon / head-block invariants
#   - release-notes guard
#   - localization parity checks
# This keeps .githooks/pre-push pristine (blueprint-managed) and lets the
# blueprint sync forward without trampling your project guards.
if [ -f .githooks/pre-push-project ]; then
  echo "  → Project-specific guards..."
  . .githooks/pre-push-project
fi

echo "✅ All checks passed. Pushing..."
