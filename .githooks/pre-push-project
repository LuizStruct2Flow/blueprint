      echo "   Persona identity must resolve from AGENT_ROSTER.md by ROLE, via"
      echo "   scripts/lib/roster.sh — never from a name baked into a managed script."
      return 1
    }
  }
  pipe_stage "roster · BUG-010" _st_roster
else
  pipe_skip "roster · BUG-010" "suite absent"
fi

# A-03 — the secret gate must scan the COMMITS BEING PUSHED, not the index.
# `gitleaks protect --staged` scanned an index that is always empty at pre-push
# time, so the gate CLAUDE.md §Security calls blocking was a no-op in the normal
# commit-then-push flow. Unrun, this regression is invisible: a secret gate that
# silently scans nothing looks exactly like one that finds nothing. ~0.3s.
# Runs in FULL as of 2026-08-02. The budget cases drive a hanging scanner and
# were skipped purely on cost; they prove the scan fails CLOSED when it cannot
# finish, which is exactly the case where a silent pass ships secrets.
if [ -f tests/pre-push-secrets/test.sh ]; then
  _st_pre_push_secrets(){
    bash tests/pre-push-secrets/test.sh || {
      echo "❌ tests/pre-push-secrets/test.sh failed (A-03)."
      echo "   The secret scan must cover remote..local for every ref being"
      echo "   pushed, or secrets ride out in commits nothing ever looked at."
      return 1
    }
  }
  pipe_stage "pre-push-secrets · A-03" _st_pre_push_secrets
else
  pipe_skip "pre-push-secrets · A-03" "suite absent"
fi

# RESTORED 2026-08-02 after Codex F2. This suite guards the autonomous handoff
# path: a regression here silently dispatches an agent against work that is
# already finished, which happened twice in one session and is what the suite
# exists to prevent. It was CI-only at 125.4 s, and I defended that as a risk
# call — Codex showed the cost was scaffolding, not signal (the watcher ran to a
# fixed timeout regardless of when each assertion became decidable). Re-clocked
# to 75.0 s with every assertion intact, so the tier question answers itself.
# (37.5 s was measured first, at SETTLE=1 — an unsound clock; see the suite.)
if [ -f tests/signal-dispatch/test.sh ]; then
  _st_signal_dispatch(){
    bash tests/signal-dispatch/test.sh || {
      echo "❌ tests/signal-dispatch/test.sh failed."
      echo "   The watcher must not dispatch on a Task nobody updated — a"
      echo "   State-first edit publishes a torn baton and sends an agent"
      echo "   against the previous round's work."
      return 1
    }
  }
  pipe_stage "signal-dispatch" _st_signal_dispatch
else
  pipe_skip "signal-dispatch" "suite absent"
fi

