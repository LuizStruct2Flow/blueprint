#!/bin/sh
# Project-specific pre-push guards for the BLUEPRINT repo itself.
#
# Sourced by .githooks/pre-push (see its "Project-specific guards" section).
# The generic hook runs build/lint/test per workspace, but this repo has no
# backend/ or frontend/ — so without this file its own regression tests run
# NOWHERE and a regression to the sync CLI or the bootstrap script pushes green.
# That gap was audit finding A-15.
#
# Keep every check here fast: the whole pre-push gate has a 30 s ceiling
# (CLAUDE.md §"Pre-push tolerance"). Measured total for this file: ~19 s, almost
# all of it the agent-activity --fast suite. The whole hook measures ~20 s.

echo "  → Blueprint shell regression tests..."

# BP-7 — `blueprint pull` must do a marker-aware merge, preserving the
# project's outside-marker content byte-for-byte.
if [ -f tests/marker-merge/test.sh ]; then
  bash tests/marker-merge/test.sh || {
    echo "❌ tests/marker-merge/test.sh failed — marker-aware merge is broken."
    echo "   A pull would clobber project-owned content outside the markers."
    exit 1
  }
fi

# BUG-001 — the activity feed must hold exactly one instance with a bounded
# process set, and must read file deltas byte-correctly. Guards the fork-bomb
# regression plus the two silent-data-loss defects found in review rounds 3/4.
# --fast: the full suite is ~29 s on its own and the WHOLE gate has a 30 s
# ceiling (CLAUDE.md §"Pre-push tolerance"). The rule is to move work out of
# pre-push, not to weaken the ceiling.
#
# What --fast runs: the shipped BUG-001 mechanisms (RC-1 instance guard, RC-2
# per-transcript followers INCLUDING #2's 40→80 scaling assertion, RC-3
# teardown, RC-6 change detection) plus the cheap review-found regressions worth
# blocking on (R3 command-substitution, R4 byte/char, I-2 nonce, I-3 change
# token). Those four were caught in review and never shipped, so "covers what
# shipped" would be the wrong criterion — the criterion is "shipped mechanisms
# plus cheap regressions worth blocking on".
#
# What CI adds (.github/workflows/security.yml): the deterministic race /
# fault-injection cases #10 and #18, and foreground mode. Both halves run — a
# suite nothing executes is the A-15 defect this repo already had once.
if [ -f tests/agent-activity-bound/test.sh ]; then
  bash tests/agent-activity-bound/test.sh --fast || {
    echo "❌ tests/agent-activity-bound/test.sh failed (BUG-001)."
    echo "   The feed must stay one flock-guarded process with no 'tail -F'"
    echo "   followers, and its delta reads must stay byte-exact."
    exit 1
  }
fi

# BUG-003 — the security gate must distinguish "scanner found something" from
# "scanner could not run". Drives this hook in an isolated fixture with shim
# scanners, so every exit-code path is deterministic. ~0.2s.
# NOTE: the fixture copies only .githooks/pre-push (not this file), so the
# nested hook run terminates rather than recursing.
if [ -f tests/pre-push-scanners/test.sh ]; then
  bash tests/pre-push-scanners/test.sh || {
    echo "❌ tests/pre-push-scanners/test.sh failed (BUG-003)."
    echo "   A broken scanner must never be reported as a security finding, and"
    echo "   a tool failure must fail closed rather than pass as a clean scan."
    exit 1
  }
fi

# A-14 — bootstrap must INHERIT the operator's git identity, never write one,
# and must fail before creating anything when no identity is resolvable.
if [ -f tests/bootstrap-identity/test.sh ]; then
  bash tests/bootstrap-identity/test.sh || {
    echo "❌ tests/bootstrap-identity/test.sh failed."
    echo "   Bootstrap must inherit the git author identity (never hardcode one)"
    echo "   and must not leave a half-bootstrapped directory behind."
    exit 1
  }
fi
