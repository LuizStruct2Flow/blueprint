    bash tests/staleness/test.sh || {
      echo "❌ tests/staleness/test.sh failed."
      echo "   The staleness probe must bound its offer and never report an"
      echo "   unknown checkout as current."
      return 1
    }
  }
  pipe_stage "staleness probe" _st_staleness_probe
else
  pipe_skip "staleness probe" "suite absent"
fi

