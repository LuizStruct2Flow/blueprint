      echo "   must unset GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE before git init."
      return 1
    }
  }
  pipe_stage "git-isolation · BUG-014" _st_git_isolation
else
  pipe_skip "git-isolation · BUG-014" "suite absent"
fi

