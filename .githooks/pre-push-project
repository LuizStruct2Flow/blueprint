# and sent a push out ungated. The suite that proves the gate arms was disarming
# it. Cheap (~1 s) and guards the gate's own integrity.
if [ -f tests/git-isolation/test.sh ]; then
  _st_git_isolation(){
    bash tests/git-isolation/test.sh || {
      echo "❌ tests/git-isolation/test.sh failed (BUG-014)."
