#!/usr/bin/env bash
#
# blueprint — sync CLI for struct2flow projects.
#
# Subcommands:
#   blueprint drift             Show which blueprint-managed files in this project
#                               have drifted from the blueprint HEAD, and what's
#                               changed in the blueprint since this project was
#                               last synced.
#   blueprint pull [FILE...]    Pull blueprint-managed files forward into this
#                               project. Interactive per file unless --yes.
#                               With no FILE, pulls every file that's drifted.
#   blueprint a2bp FILE [...]   Apply-to-blueprint: file a REQUEST that this
#                               project's version of FILE(s) be adopted upstream
#                               — a branch plus a pull request against the
#                               blueprint's remote. It writes into no working
#                               tree and cannot land anything. The blueprint
#                               owner implements it: merging as-is, adapting, or
#                               rewriting. Add --dry-run to see the diff without
#                               filing.
#   blueprint prs               List open a2bp requests, plus pushed branches
#                               with no PR.
#   blueprint files             List the blueprint-managed files (source of truth).
#   blueprint help              This message.
#
# `drift` and `pull` read the LOCAL blueprint checkout named by
# blueprint_source in .blueprint-source. `a2bp` and `prs` talk to the REMOTE
# named by blueprint_remote (config_version 2), because a request has to go
# somewhere other people can see. All commands except `files` and `help` must
# run from inside a struct2flow project.
#
# Add this directory to PATH so the command is callable as `blueprint`:
#   export PATH="$HOME/sources/struct2flow/blueprint/scripts:$PATH"
# Or symlink it:
#   ln -s ~/sources/struct2flow/blueprint/scripts/blueprint /usr/local/bin/blueprint

set -euo pipefail

# THE forward substitution for {{PROJECT_NAME}}, shared by pull, drift's
# comparison and a2bp's round-trip verifier. Sourced at top level so all three
# provably use one semantics (A-07 R5-F1) — three near-copies had drifted apart
# and disagreed on names containing `&` or `\`.
#
# A missing helper must NOT abort the whole CLI at load time. `blueprint drift`
# is one of the two paths that arm the pre-push gate (A-22), and it arms it
# before it needs any substitution — exiting here would leave a checkout
# silently ungated, which is the exact defect A-22 closed. So substitution
# fails loudly at the point of use, and everything that does not substitute
# still works.
_bp_placeholders="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/placeholders.sh"
if [ -r "$_bp_placeholders" ]; then
  # shellcheck source=scripts/lib/placeholders.sh
  . "$_bp_placeholders"
else
  bp_substitute_stream()   { die "scripts/lib/placeholders.sh is missing — cannot substitute safely"; }
  bp_substitute_in_place() { die "scripts/lib/placeholders.sh is missing — cannot substitute safely"; }
fi

# --- Canonical list of blueprint-managed files ---
# This is the SINGLE SOURCE OF TRUTH for "which files does the blueprint
# own". The README.md and CLAUDE.md link here; do not duplicate the list
# elsewhere.
#
# Rules for what belongs in this list:
#   - Generic to every struct2flow project (no {{PROJECT_NAME}} after
#     bootstrap substitution → the file's content is the same everywhere).
#   - Improving it in one project should benefit every project (that's
#     what blueprint sync is for).
#
# What does NOT belong (project-owned, never synced):
#   - project_config_*.md  (the whole point of these files is project drift)
#   - AGENT_SIGNAL.md, HANDOVER.md, BUGS.md, BACKLOG.md, PLAN-*.md, etc.
#   - backend/, frontend/, infra/, src/, anywhere with project code
#   - .claude/settings.local.json (host-specific)
#
# An entry ending in `/` names a DIRECTORY, and stands for every file the
# blueprint SHIPS under it (bp_expand_managed_dirs below). Sync of a directory
# is ADDITIVE ONLY: files the blueprint has are created and updated, and nothing
# is ever deleted — see the "no delete path" note on that function.

MANAGED_FILES=(
  # Top-level agent protocol
