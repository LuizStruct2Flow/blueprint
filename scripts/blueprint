# --- ANSI ---
if [ -t 1 ]; then
  C_RED=$'\033[31m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_BLUE=$'\033[34m'
  C_BOLD=$'\033[1m'
  C_DIM=$'\033[2m'
  C_RESET=$'\033[0m'
else
  C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_BOLD=""; C_DIM=""; C_RESET=""
fi

# --- Helpers ---
die() {
  echo "${C_RED}error:${C_RESET} $*" >&2
  exit 1
}

# --- Marker pattern ---
# Blueprint-managed regions in a project file are bounded by lines
# matching BLUEPRINT:BEGIN / BLUEPRINT:END. The marker text is just a
# substring — the surrounding comment syntax (HTML, shell, JS) is up to
# the file's language. Pull behavior:
#
#   - Both files have matched markers → marker-aware merge: project's
#     outside-marker content is preserved byte-identical; only the
#     inside-marker regions are replaced with blueprint's.
#   - Neither file has markers → legacy whole-file copy.
#   - Asymmetric (one has markers, the other doesn't) → fall back to
#     whole-file copy with a `.bp-bak` backup of the project file and
#     a loud warning. Project owner reconciles.
#   - Marker structure mismatch (different region count, unbalanced
#     BEGIN/END) → fall back to whole-file copy with `.bp-bak` and a
#     warning.

# marker_aware_merge BP_FILE PROJ_FILE OUT_FILE
# Returns 0 on success, 1 on structural mismatch.
marker_aware_merge() {
  local bp_file="$1"
  local proj_file="$2"
  local out_file="$3"

  local bp_begin proj_begin bp_end proj_end
  bp_begin=$(grep -c 'BLUEPRINT:BEGIN' "$bp_file" 2>/dev/null || true)
  bp_end=$(grep -c 'BLUEPRINT:END' "$bp_file" 2>/dev/null || true)
  proj_begin=$(grep -c 'BLUEPRINT:BEGIN' "$proj_file" 2>/dev/null || true)
  proj_end=$(grep -c 'BLUEPRINT:END' "$proj_file" 2>/dev/null || true)

  [ -z "$bp_begin" ] && bp_begin=0
  [ -z "$bp_end" ] && bp_end=0
  [ -z "$proj_begin" ] && proj_begin=0
  [ -z "$proj_end" ] && proj_end=0

  if [ "$bp_begin" -ne "$bp_end" ] || [ "$proj_begin" -ne "$proj_end" ] || [ "$bp_begin" -ne "$proj_begin" ]; then
    return 1
  fi

  awk -v bp_file="$bp_file" '
    function read_bp_inside_regions(   line, region_idx, capture) {
      region_idx = 0
      capture = 0
      while ((getline line < bp_file) > 0) {
        if (line ~ /BLUEPRINT:BEGIN/) {
          capture = 1
          region_idx++
          bp_inside[region_idx] = ""
          continue
        }
        if (line ~ /BLUEPRINT:END/) {
          capture = 0
          continue
        }
        if (capture) {
          bp_inside[region_idx] = bp_inside[region_idx] line "\n"
        }
      }
      close(bp_file)
      bp_n_regions = region_idx
    }
    BEGIN { read_bp_inside_regions() ; cur_region = 0 ; in_inside = 0 }
    /BLUEPRINT:BEGIN/ {
      print
      cur_region++
      printf "%s", bp_inside[cur_region]
      in_inside = 1
      next
    }
    /BLUEPRINT:END/ {
      print
      in_inside = 0
      next
    }
    in_inside { next }
    { print }
  ' "$proj_file" > "$out_file"
}

# pull_file BP_FILE PROJ_FILE
# Decides between marker-aware merge and whole-file copy. Backs up the
# project file as PROJ_FILE.bp-bak when falling back due to a marker
# mismatch (so the project owner can recover the local content).
# Substitute the blueprint template placeholders with the project's
# name. The blueprint stores template tokens like `{{PROJECT_NAME}}`
# / `{{PROJECT_NAME_UPPER}}` so the same managed file can serve every
# project. `new-project.sh` runs this on bootstrap; this function
# repeats it after each `pull` so a pulled file lands as a real,
# usable file instead of leaking the literal placeholder. The project
# name is the basename of the project root.
# Skip files that legitimately document or implement the substitution itself.
# The predicate lives in scripts/lib/placeholders.sh beside the primitive it
# guards, so bootstrap, pull, drift and a2bp cannot disagree about it (BUG-028).
_should_substitute() { bp_should_substitute "$1"; }

# Write a placeholder-substituted COPY of the blueprint file to a
# temp path and print the temp path. Used by drift comparison +
# pull's "same?" check so the templated blueprint side is compared
# against the substituted project side instead of producing infinite
# false drift.
# BUG-029 R2-S2 — the argument is the REPO-RELATIVE path, never
# "$BLUEPRINT_ROOT/$f". This was the one call site of five that passed an
# absolute path, and it made bp_should_substitute's answer a function of WHERE
# THE BLUEPRINT IS CHECKED OUT. Every other exemption there is suffix-anchored
# (`*scripts/blueprint`), so it survived that by luck; the moment a rule needed
# a LEADING component the luck ran out, and a blueprint living under any
# directory named `tests/` would silently stop substituting {{PROJECT_NAME}} in
# every managed file. The predicate is about a file's identity in the repo, so
# it gets the repo-relative path and nothing else.
substituted_blueprint_copy() {
  local f="$1" bp="$BLUEPRINT_ROOT/$1"
  if ! _should_substitute "$f"; then
    echo "$bp"
    return 0
  fi
  local proj_name
  # ${PWD##*/}, not $(basename ...) — command substitution strips trailing
  # newlines, so a directory legally named with one was silently seen as a
  # different project (A-07 R6-F1). Parameter expansion preserves the bytes;
  # bp_validate_project_name then refuses what sync cannot represent.
  proj_name=${PWD##*/}
  local tmp
  tmp=$(mktemp)
  # Same primitive as pull and as a2bp's verifier (A-07 R5-F1) — drift must
  # compare against exactly what pull would produce, not an approximation.
  bp_substitute_stream "$bp" "$proj_name" > "$tmp"
  echo "$tmp"
}

# Substitute placeholders in a file in-place. Called after every pull
# `cp` so the project file lands as a real, usable file instead of
# leaking the literal `{{PROJECT_NAME}}` token.
substitute_placeholders() {
  local f="$1"
  if ! _should_substitute "$f"; then return 0; fi
  local proj_name
  # ${PWD##*/}, not $(basename ...) — command substitution strips trailing
  # newlines, so a directory legally named with one was silently seen as a
  # different project (A-07 R6-F1). Parameter expansion preserves the bytes;
  # bp_validate_project_name then refuses what sync cannot represent.
  proj_name=${PWD##*/}
  if grep -q '{{PROJECT_NAME' "$f" 2>/dev/null; then
    # A-07 R5-F1: one shared literal primitive, never an interpolated sed.
    # The project name is data; a name containing `&` or `\` was previously
    # mangled here (and differently again in a2bp's verifier).
    bp_substitute_in_place "$f" "$proj_name"
  fi
}

pull_file() {
  local bp="$1"
  local f="$2"

  # New file in project → whole-file copy (no merging possible).
  if [ ! -f "$f" ]; then
    cp "$bp" "$f"
    substitute_placeholders "$f"
    return 0
  fi

  local bp_has=0 proj_has=0
  grep -q 'BLUEPRINT:BEGIN' "$bp" 2>/dev/null && bp_has=1
  grep -q 'BLUEPRINT:BEGIN' "$f"  2>/dev/null && proj_has=1

  if [ "$bp_has" -eq 1 ] && [ "$proj_has" -eq 1 ]; then
    local tmp
    tmp=$(mktemp)
    if marker_aware_merge "$bp" "$f" "$tmp"; then
      mv "$tmp" "$f"
      _bp_sync_exec_bit "$bp" "$f"
      substitute_placeholders "$f"
      echo "  ${C_DIM}    (marker-aware merge: project outside-marker content preserved)${C_RESET}"
      return 0
    else
      rm -f "$tmp"
      echo "  ${C_YELLOW}    warn: marker structure mismatch — backing up + whole-file copy${C_RESET}"
      cp "$f" "$f.bp-bak"
      cp "$bp" "$f"
      _bp_sync_exec_bit "$bp" "$f"
      substitute_placeholders "$f"
      echo "  ${C_DIM}    backup at $f.bp-bak — reconcile manually${C_RESET}"
      return 0
    fi
  fi

  if [ "$bp_has" -eq 1 ] && [ "$proj_has" -eq 0 ]; then
    echo "  ${C_YELLOW}    warn: blueprint uses markers, project doesn't — backing up + whole-file copy${C_RESET}"
    cp "$f" "$f.bp-bak"
    cp "$bp" "$f"
    _bp_sync_exec_bit "$bp" "$f"
    substitute_placeholders "$f"
    echo "  ${C_DIM}    backup at $f.bp-bak — add markers in the project to preserve content next pull${C_RESET}"
    return 0
  fi

  if [ "$bp_has" -eq 0 ] && [ "$proj_has" -eq 1 ]; then
    echo "  ${C_RED}    refuse: project has markers but blueprint doesn't — pull would strip them${C_RESET}"
    echo "  ${C_DIM}    either the blueprint version is stale (run a2bp from another project),${C_RESET}"
    echo "  ${C_DIM}    or remove markers locally if they're no longer wanted. Skipping this file.${C_RESET}"
    return 1
  fi

  # Neither has markers — legacy whole-file copy.
  cp "$bp" "$f"
  _bp_sync_exec_bit "$bp" "$f"
  substitute_placeholders "$f"
}

# Where is the blueprint checkout on THIS machine?
#
# `blueprint_source` is an absolute host path, which makes it the one field in
# `.blueprint-source` that cannot be correct on two machines at once. storm2flow
# carried `/Users/luizscheidegger/...` and every command died on the Linux box;
# writing the Linux path would have broken the Mac instead. Picking a machine to
# break is not a fix, so the value is now RESOLVED rather than read (BUG-007):
#
#   1. $BLUEPRINT_ROOT, if exported and real — an explicit per-shell override.
#   2. `blueprint_source` from the file, if it exists on this machine.
#   3. The repo the RUNNING CLI lives in, if that looks like a blueprint.
#
# Step 3 is what makes it machine-independent, and it is not a guess: if you are
# executing `…/blueprint/scripts/blueprint`, then `…/blueprint` is a blueprint
# checkout by construction. It is verified (MANAGED_FILES must be present) and
# announced, never silent — a silently-substituted comparison base would make
# every drift report untrustworthy.
_bp_resolve_blueprint_root() {
  local from_file="$1" cli_root self

  if [ -n "${BLUEPRINT_ROOT:-}" ] && [ -d "$BLUEPRINT_ROOT" ]; then
    printf '%s' "$BLUEPRINT_ROOT"; return 0
  fi
  if [ -n "$from_file" ] && [ -d "$from_file" ]; then
    printf '%s' "$from_file"; return 0
  fi

  # Resolve through a symlink: CLAUDE.md documents `ln -s .../scripts/blueprint`
  # as an install method, and dirname of the symlink is /usr/local/bin.
  self="${BASH_SOURCE[0]}"
  if command -v readlink >/dev/null 2>&1; then
    local resolved
    resolved=$(readlink -f "$self" 2>/dev/null) && [ -n "$resolved" ] && self="$resolved"
  fi
  cli_root=$(cd "$(dirname "$self")/.." 2>/dev/null && pwd -P) || return 1

  # Verified, not assumed — a directory containing scripts/blueprint is not
  # necessarily a blueprint.
  if [ -n "$cli_root" ] && [ -f "$cli_root/CLAUDE.md" ] && [ -f "$cli_root/docs/DoD.md" ]; then
    echo "${C_YELLOW}⚠ .blueprint-source names '${from_file:-<empty>}', which does not exist here.${C_RESET}" >&2
    echo "${C_DIM}  Falling back to the blueprint this CLI runs from: $cli_root${C_RESET}" >&2
    echo "${C_DIM}  (that field is an absolute host path, so it cannot be right on two${C_RESET}" >&2
    echo "${C_DIM}   machines at once — export BLUEPRINT_ROOT to pin it explicitly)${C_RESET}" >&2
    printf '%s' "$cli_root"; return 0
  fi
  return 1
}

# --- BUG-008: a pulled file must keep the blueprint's executable bit ----------
# The marker-aware merge writes to a `mktemp` (mode 600) and then `mv`s it into
# place, and `mv` carries the TEMP's mode onto the destination. So pulling
# `.githooks/pre-push` — a marker-bearing file — landed it at 600.
#
# That is silent and it is severe: `core.hooksPath` is set, so the gate LOOKS
# armed, but git skips a non-executable hook without a word. The project is
# ungated while every indicator says otherwise — BUG-004's failure mode arriving
# through a different door. Found in linkedin-watcher-agent on 2026-07-30, where
# the feed's own arming check was the only thing that noticed.
#
# Only the exec bit is mirrored, not the whole mode: the blueprint is the source
# of truth for "is this a program", while read/write bits are the operator's
# business (umask, group setups).
_bp_sync_exec_bit() {
  local src="$1" dst="$2"
  [ -e "$src" ] && [ -e "$dst" ] || return 0
  if [ -x "$src" ]; then chmod +x "$dst" 2>/dev/null || true
  else chmod -x "$dst" 2>/dev/null || true; fi
}

read_blueprint_source() {
  if [ ! -f .blueprint-source ]; then
    # Three different situations reach here and they need three different
    # answers. Telling a derived project "not a struct2flow project" — which is
    # what this used to do — is both false and useless, because the operator IS
    # standing in the project root and will go looking for a bug in their cwd.
    local markers=0 m
    for m in AGENT_SIGNAL.md AGENTS.md CLAUDE.md STACK_DEFAULTS.md Brewfile \
             .githooks/pre-push scripts/blueprint scripts/agent-activity.sh docs/DoD.md; do
      [ -e "$m" ] && markers=$((markers+1))
    done

    if [ "$markers" -ge 3 ]; then
      echo "${C_YELLOW}This looks like a struct2flow project ($markers marker files), but it was${C_RESET}" >&2
      echo "${C_YELLOW}NEVER REGISTERED with blueprint sync — there is no .blueprint-source.${C_RESET}" >&2
      echo >&2
      echo "So 'drift' and 'pull' have never done anything here. Adopt it by creating" >&2
      echo "$(pwd)/.blueprint-source with:" >&2
      echo >&2
      echo "  config_version   = 2" >&2
      echo "  blueprint_source = <path to your blueprint checkout, RELATIVE to here, e.g. ../blueprint>" >&2
      echo "  blueprint_remote = git@github.com:<owner>/<blueprint>.git" >&2
      echo "  blueprint_branch = main" >&2
      echo "  bootstrap_sha    = <blueprint commit you are adopting against>" >&2
      echo "  bootstrap_date   = $(date '+%Y-%m-%d')" >&2
      die "unregistered struct2flow project — see the lines above"
    fi
    die "no .blueprint-source in $(pwd) — not a struct2flow project (run from project root)"
  fi

  local from_file
  from_file=$(grep '^blueprint_source' .blueprint-source | cut -d= -f2- | xargs)
  BOOTSTRAP_SHA=$(grep '^bootstrap_sha' .blueprint-source | cut -d= -f2- | xargs)
  BOOTSTRAP_DATE=$(grep '^bootstrap_date' .blueprint-source | cut -d= -f2- | xargs)

  BLUEPRINT_ROOT=$(_bp_resolve_blueprint_root "$from_file") || \
    die ".blueprint-source points at '$from_file' which does not exist, and no blueprint checkout could be resolved (export BLUEPRINT_ROOT=<path>)"

  # Every MANAGED_FILES consumer below this point walks a list of FILES. Expand
  # here, once, so `drift` and both of `pull`'s loops are unchanged (BUG-029).
  bp_expand_managed_dirs
}

# --- BUG-029: a MANAGED_FILES entry ending in `/` names a directory ----------
#
# Replaces each such entry with the files the blueprint SHIPS under it. Called
# at the end of read_blueprint_source, which is the one place every path that
# needs BLUEPRINT_ROOT goes through — so drift and pull get the expansion for
# free and nothing else has to know directories exist.
#
# THE LISTING IS `git archive HEAD <dir>`. Two parts of that are load-bearing
# and neither is the obvious choice:
#
#   - `git archive`, NOT `git check-attr export-ignore`. A trailing-slash
#     directory pattern in `.gitattributes` does NOT propagate to the files
#     underneath it: `git check-attr export-ignore tests/bootstrap-contents/
#     test.sh` reports `unspecified` for a file `git archive` genuinely drops.
#     Archiving is the only query that answers "what ships". tests/manifest
#     (:139-141) rejected check-attr for exactly this and had to say so; the
#     trap is now pinned by tests/suite-sync #1c so nobody re-walks it.
#   - HEAD, not the working tree — the same argument tests/manifest #2b makes.
#     An uncommitted suite must not sync, or a project pulls a file that does
#     not exist upstream yet. CONTENT still comes from the working tree, as it
#     does for every other managed file.
#
# So the expansion is precisely "the files a bootstrap would have received",
# which is the set a pull has to keep current.
#
# THERE IS NO DELETE PATH, deliberately. The information that distinguishes
# "the blueprint dropped this suite" from "the project wrote this suite" does
# not exist in the project, and a prefix-based delete would take out
# project-authored suites — the one failure mode worse than the bug. The
# announcement already exists and is fail-closed: when a suite's row leaves
# tests/SUITES.md, tests/manifest #1 fails the derived push naming the orphan
# directory.
# IT FAILS CLOSED (BUG-029 R2-S1). An expansion that errors, or that yields
# nothing, is a HARD failure — never an empty list.
#
# The first version warned and carried on, which reproduced BUG-029 inside its
# own fix: `tests/` would silently expand to nothing, `drift` would compare zero
# suites, report "✓ All blueprint-managed files match" and exit 0. A mechanism
# that is present, reports nothing, and whose silence is indistinguishable from
# success is the exact shape of A-22, BUG-004, BUG-018 and BUG-028 — four times
# already in this repo, and it went straight back in through the door built to
# close it. There is no such thing as "a managed directory that happens to be
# empty today": either the blueprint ships files there and they must sync, or
# the entry does not belong in MANAGED_FILES.
#
# STATUS IS CAPTURED OUTSIDE THE PIPE. `x=$(a | b | c)` yields only c's status,
# so a failed `git archive` feeding a successful `grep` reads as success with
# empty output — the trap behind BUG-027 finding (b), where a killed lookup's
# partial stdout was accepted because its status vanished in `$( )`. Each stage
# runs on its own, to a file, and is checked. `grep`'s own no-match 1 is the one
# expected non-zero, and the emptiness check below is what actually judges it.
bp_expand_managed_dirs() {
  local expanded=() f listing line tarf listf
  for f in "${MANAGED_FILES[@]}"; do
    case "$f" in
      */) ;;
      *)  expanded+=("$f"); continue ;;
    esac

    tarf=$(mktemp) || die "cannot create a temp file to expand managed directory '$f'"
    listf=$(mktemp) || die "cannot create a temp file to expand managed directory '$f'"

    if ! git -C "$BLUEPRINT_ROOT" archive --format=tar HEAD "${f%/}" >"$tarf" 2>/dev/null; then
      rm -f "$tarf" "$listf"
      _bp_expand_die "$f" "'git archive HEAD ${f%/}' failed — the path is not in the blueprint's HEAD, or the checkout is unreadable"
    fi
    if ! tar -tf "$tarf" >"$listf" 2>/dev/null; then
      rm -f "$tarf" "$listf"
      _bp_expand_die "$f" "the archive could not be listed ('tar -t' failed)"
    fi
    listing=$(grep -v '/$' "$listf" || true)
    rm -f "$tarf" "$listf"

    if [ -z "$listing" ]; then
      _bp_expand_die "$f" "it contains no shipping files at HEAD — every file under it is uncommitted or export-ignore'd"
    fi

    while IFS= read -r line; do
      if [ -n "$line" ]; then expanded+=("$line"); fi
    done <<< "$listing"
  done
  MANAGED_FILES=("${expanded[@]}")
}

# One message, so the failure always says which entry and always says why
# continuing would be worse than stopping.
_bp_expand_die() {
  local entry="$1" why="$2"
  echo "${C_RED}error:${C_RESET} managed directory '$entry' expanded to nothing: $why" >&2
  echo "${C_DIM}  Refusing to continue. Carrying on would sync ZERO files from '$entry' while${C_RESET}" >&2
  echo "${C_DIM}  reporting success — a project would read '✓ everything matches' and be wrong.${C_RESET}" >&2
  echo "${C_DIM}  Fix the blueprint checkout (is '${entry%/}' committed at HEAD?), or remove${C_RESET}" >&2
  echo "${C_DIM}  '$entry' from MANAGED_FILES in scripts/blueprint if it is genuinely gone.${C_RESET}" >&2
  exit 1
}

# --- Subcommand: files ---
cmd_files() {
  echo "${C_BOLD}Blueprint-managed files (synced by 'blueprint pull'):${C_RESET}"
  for f in "${MANAGED_FILES[@]}"; do
    echo "  $f"
  done
  echo
  echo "${C_BOLD}Template files (seeded once at bootstrap, then project-owned):${C_RESET}"
  for f in "${TEMPLATE_FILES[@]}"; do
    echo "  $f"
  done
  echo
  echo "${C_DIM}Source of truth: scripts/blueprint MANAGED_FILES array.${C_RESET}"
}

# --- Is BLUEPRINT_ROOT itself behind its remote? ---
# `drift` answers "does this project match the blueprint?" by comparing against
# BLUEPRINT_ROOT — the operator's LOCAL checkout. So a green result can mean
# "you match a copy of the blueprint that is six weeks old". While a2bp also
# wrote to that same local copy the two commands at least agreed on what "the
# blueprint" meant; once a2bp files against the remote, drift is the one command
# that can be confidently wrong. Plan §3b.
report_staleness() {
  local root="$1" out status blocker offer remote count verified branch

  local lib="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/staleness.sh"
  if [ ! -r "$lib" ]; then
    echo "  ${C_DIM}remote staleness: unknown (scripts/lib/staleness.sh missing)${C_RESET}"
    return 0
  fi
  # shellcheck source=scripts/lib/staleness.sh
  . "$lib"

  # Under config v2 the branch is declared; under v1 there is nothing to read,
  # so fall back to whatever the checkout is actually on. That is the right
  # question anyway — "is YOUR checkout behind ITS remote?".
  branch="${BLUEPRINT_BRANCH:-}"
  if [ -z "$branch" ]; then
    branch=$(git -C "$root" symbolic-ref --quiet --short HEAD 2>/dev/null || echo main)
  fi

  out=$(bp_staleness_assess "$root" "$branch") || return 0

  # `|| true` is load-bearing under `set -e`, not defensive noise. Several of
  # these keys are legitimately absent — `count` only appears on a verified
  # behind-relation — and a grep that matches nothing exits 1, which aborts the
  # whole CLI mid-report. That is exactly how the first version of this function
  # produced no staleness line at all AND made `blueprint drift` exit 1 on a
  # perfectly healthy project.
  _f() { printf '%s\n' "$out" | grep "^$1=" | cut -d= -f2- || true; }
  status=$(_f status)
  blocker=$(_f blocker)
  offer=$(_f offer)
  remote=$(_f remote)
  count=$(_f count)
  verified=$(_f verified)

  case "$status" in
    current)
      echo "  ${C_GREEN}✓ local checkout is level with $remote/$branch${C_RESET}"
      return 0 ;;
    unknown)
      # Never silently imply "current". A failed probe is ignorance, and saying
      # so is the entire point of the feature.
      echo "  ${C_DIM}? staleness unknown ($blocker) — cannot confirm the checkout is current${C_RESET}"
      return 0 ;;
    ahead)
      echo "  ${C_DIM}local checkout is ahead of $remote/$branch (unpushed commits)${C_RESET}"
      return 0 ;;
    diverged)
      echo "  ${C_YELLOW}⚠ local checkout has DIVERGED from $remote/$branch${C_RESET}"
      echo "  ${C_DIM}    resolve by hand — a merge or rebase is not a prompt${C_RESET}"
      return 0 ;;
  esac

  # status=behind
  if [ "$verified" = "yes" ] && [ -n "$count" ]; then
    echo "  ${C_YELLOW}⚠ local checkout is $count commit(s) behind $remote/$branch${C_RESET}"
  else
    echo "  ${C_YELLOW}⚠ local checkout is behind $remote/$branch${C_RESET}"
  fi

  if [ "$offer" != "ff" ]; then
    case "$blocker" in
      dirty)        echo "  ${C_DIM}    not offering: uncommitted or untracked changes there${C_RESET}" ;;
      detached)     echo "  ${C_DIM}    not offering: that checkout is on a detached HEAD${C_RESET}" ;;
      wrong-branch) echo "  ${C_DIM}    not offering: that checkout is not on $branch${C_RESET}" ;;
      *)            echo "  ${C_DIM}    not offering ($blocker)${C_RESET}" ;;
    esac
    return 0
  fi

  # `drift` runs at every agent wake, usually with no TTY. A blocking prompt
  # there would hang the wake protocol — worse than the stale checkout it is
  # reporting. So the WARNING is unconditional and the OFFER needs a human.
  if [ "${BP_NO_PROMPT:-0}" = "1" ] || [ ! -t 0 ]; then
    echo "  ${C_DIM}    fast-forward it with: git -C $root merge --ff-only${C_RESET}"
    return 0
  fi

  local reply=""
  printf '      fast-forward it now? [y/N] '
  read -r reply || reply=""
  case "$reply" in
    y|Y)
      if bp_staleness_fast_forward "$root" "$branch" "$remote"; then
        echo "  ${C_GREEN}✓ fast-forwarded to $(git -C "$root" rev-parse --short HEAD)${C_RESET}"
      else
        # --ff-only re-checks against freshly fetched objects, so this is the
        # normal, safe refusal when the remote moved since the probe.
        echo "  ${C_YELLOW}fast-forward refused — the checkout is untouched${C_RESET}"
      fi ;;
    *)
      echo "  ${C_DIM}    left alone${C_RESET}" ;;
  esac
}

# --- Are we standing in the blueprint itself? ---
# Positive identification, not "there is no .blueprint-source" — a derived
# project that lost its config has no .blueprint-source either, and calling that
# one "the blueprint" would silently skip every comparison it needs. That
# reasoning still holds and is why the marker below is a POSITIVE test.
#
# BUG-013 — the previous signal was "the CLI you are running belongs to the repo
# you are standing in". That reads as sound and is worthless: `scripts/blueprint`
# is itself a MANAGED file, shipped to every derived project at exactly that
# path. So the signal was trivially true everywhere, and
# `bash scripts/blueprint drift` — the fallback CLAUDE.md documents, and what a
# fresh clone and every spawned persona use — reported "This IS the blueprint"
# and exited 0 having compared nothing. linkedin-watcher-agent sat 18 commits
# behind for a morning while drift called it clean.
#
# The signal is now an explicit marker file that CANNOT reach a derived project:
# `.blueprint-root` is `export-ignore` (so `git archive`, which new-project.sh
# bootstraps from, omits it) AND absent from MANAGED_FILES (so `pull` never
# copies it). Two independent mechanisms, because this one failing silently is
# what made BUG-013 expensive.
#
# It deliberately does NOT also require the CLI-belongs-here test: that would
# reintroduce a false NEGATIVE for the legitimate `blueprint drift` form run via
# a PATH symlink from inside the blueprint.
_bp_is_blueprint_itself() {
  local here
  here=$(git rev-parse --show-toplevel 2>/dev/null) || here="$PWD"
  here=$(cd "$here" 2>/dev/null && pwd -P) || return 1
  [ -f "$here/.blueprint-root" ]
}

# --- Subcommand: drift ---
cmd_drift() {
  # A-22: arm the pre-push gate here, BEFORE read_blueprint_source (which dies
  # when .blueprint-source is missing). `blueprint drift` is the wake-mandated
  # check (CLAUDE.md §"Wake-time drift check"), and spawned personas are told
  # NOT to start the feed — so in a derived project this is the only path that
  # covers them. Same arm_gate as the feed: one mechanism, two callers.
  _bp_lib="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/gate.sh"
  # shellcheck source=scripts/lib/gate.sh
  [ -r "$_bp_lib" ] && . "$_bp_lib" && arm_gate "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

  # BUG-007: the wake ritual runs `blueprint drift` in EVERY struct2flow repo,
  # and this one has no `.blueprint-source` because it is the source. It used to
  # die here with "not a struct2flow project" — false, useless, and it stopped
  # the mandated wake check dead in the blueprint itself.
  #
  # There is still something worth reporting here: whether this checkout is
  # behind its own remote. That is the same question `report_staleness` answers
  # for a derived project's blueprint, and it is the one thing that can be stale
  # about the source of truth.
  if _bp_is_blueprint_itself; then
    echo "${C_BOLD}Blueprint drift check${C_RESET}"
    echo "  project:    $(pwd)"
    echo "  ${C_GREEN}✓ This IS the blueprint — it is the source of truth, so there is${C_RESET}"
    echo "  ${C_GREEN}  nothing to sync against and no drift to report.${C_RESET}"
    BLUEPRINT_BRANCH=""
    report_staleness "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    echo
    echo "${C_DIM}Derived projects run this to compare themselves against here.${C_RESET}"
    echo "${C_DIM}To see what they would sync: blueprint files${C_RESET}"
    return 0
  fi

  read_blueprint_source

  echo "${C_BOLD}Blueprint drift check${C_RESET}"
  echo "  project:    $(pwd)"
  echo "  blueprint:  $BLUEPRINT_ROOT"
  echo "  bootstrap:  $BOOTSTRAP_SHA ($BOOTSTRAP_DATE)"

  CURRENT_SHA=$(git -C "$BLUEPRINT_ROOT" rev-parse HEAD 2>/dev/null || echo "no-sha")
  echo "  blueprint HEAD: $CURRENT_SHA"

  report_staleness "$BLUEPRINT_ROOT"
  echo

  if [ "$CURRENT_SHA" != "$BOOTSTRAP_SHA" ] && [ "$BOOTSTRAP_SHA" != "no-sha" ]; then
    AHEAD_COUNT=$(git -C "$BLUEPRINT_ROOT" rev-list --count "$BOOTSTRAP_SHA..$CURRENT_SHA" 2>/dev/null || echo "?")
    echo "${C_BLUE}Blueprint has $AHEAD_COUNT commit(s) since this project was last synced:${C_RESET}"
    git -C "$BLUEPRINT_ROOT" log --oneline "$BOOTSTRAP_SHA..$CURRENT_SHA" 2>/dev/null | sed 's/^/  /'
    echo
  fi

  DRIFTED=()
  MISSING_BLUEPRINT=()
  MISSING_PROJECT=()

  for f in "${MANAGED_FILES[@]}"; do
    bp="$BLUEPRINT_ROOT/$f"
    if [ ! -f "$bp" ]; then
      MISSING_BLUEPRINT+=("$f")
      continue
    fi
    if [ ! -f "$f" ]; then
      MISSING_PROJECT+=("$f")
      continue
    fi
    # Substitute placeholders on the blueprint side before comparing,
    # otherwise every templated file looks "drifted" forever after
    # the first substitute-on-pull.
    local bp_cmp
    bp_cmp=$(substituted_blueprint_copy "$f")
    if ! diff -q "$bp_cmp" "$f" >/dev/null 2>&1; then
      DRIFTED+=("$f")
    fi
    [ "$bp_cmp" != "$bp" ] && rm -f "$bp_cmp"
  done

  if [ ${#DRIFTED[@]} -eq 0 ] && [ ${#MISSING_BLUEPRINT[@]} -eq 0 ] && [ ${#MISSING_PROJECT[@]} -eq 0 ]; then
    echo "${C_GREEN}✓ All blueprint-managed files match the blueprint HEAD.${C_RESET}"
    return 0
  fi

  if [ ${#DRIFTED[@]} -gt 0 ]; then
    echo "${C_YELLOW}Drifted (project ≠ blueprint HEAD): ${#DRIFTED[@]}${C_RESET}"
    for f in "${DRIFTED[@]}"; do echo "  ${C_YELLOW}~${C_RESET} $f"; done
    echo
  fi
  if [ ${#MISSING_PROJECT[@]} -gt 0 ]; then
    echo "${C_BLUE}New in blueprint (not in this project): ${#MISSING_PROJECT[@]}${C_RESET}"
    for f in "${MISSING_PROJECT[@]}"; do echo "  ${C_BLUE}+${C_RESET} $f"; done
    echo
  fi
  if [ ${#MISSING_BLUEPRINT[@]} -gt 0 ]; then
    echo "${C_RED}Listed managed but missing in blueprint: ${#MISSING_BLUEPRINT[@]}${C_RESET}"
    for f in "${MISSING_BLUEPRINT[@]}"; do echo "  ${C_RED}!${C_RESET} $f"; done
    echo "${C_DIM}  (the MANAGED_FILES array in scripts/blueprint may be ahead of the blueprint itself)${C_RESET}"
    echo
  fi

  echo "Next:"
  echo "  ${C_DIM}blueprint pull${C_RESET}             # pull all drifted + new forward"
  echo "  ${C_DIM}blueprint pull <file>${C_RESET}      # pull one file"
  echo "  ${C_DIM}blueprint pull <file> --yes${C_RESET}  # skip the per-file prompt"
}

# --- Subcommand: pull ---
cmd_pull() {
  read_blueprint_source

  local auto_yes=0
  local files=()
  for arg in "$@"; do
    case "$arg" in
      --yes|-y) auto_yes=1 ;;
      -*) die "unknown option: $arg" ;;
      *) files+=("$arg") ;;
    esac
  done

  # BUG-016 — did the caller name specific paths? Captured HERE, before the
  # default below fills `files` with everything drifted, because afterwards the
  # two cases are indistinguishable.
  local partial=0
  [ ${#files[@]} -gt 0 ] && partial=1

  # Default: every drifted or missing file
  if [ ${#files[@]} -eq 0 ]; then
    for f in "${MANAGED_FILES[@]}"; do
      bp="$BLUEPRINT_ROOT/$f"
      if [ ! -f "$bp" ]; then continue; fi
      if [ ! -f "$f" ]; then
        files+=("$f")
        continue
      fi
      local bp_cmp
      bp_cmp=$(substituted_blueprint_copy "$f")
      if ! diff -q "$bp_cmp" "$f" >/dev/null 2>&1; then
        files+=("$f")
      fi
      [ "$bp_cmp" != "$bp" ] && rm -f "$bp_cmp"
    done
  fi

  if [ ${#files[@]} -eq 0 ]; then
    echo "${C_GREEN}✓ Nothing to pull. Project matches blueprint HEAD.${C_RESET}"
    return 0
  fi

  echo "${C_BOLD}Pulling from $BLUEPRINT_ROOT${C_RESET}"
  local pulled=0
  for f in "${files[@]}"; do
    bp="$BLUEPRINT_ROOT/$f"
    if [ ! -f "$bp" ]; then
      echo "  ${C_RED}skip${C_RESET}  $f  (not in blueprint)"
      continue
    fi
    # Compare against the substituted blueprint copy so templated
    # files that have already been substituted in the project don't
    # show as "different" forever.
    local bp_cmp_pull
    bp_cmp_pull=$(substituted_blueprint_copy "$f")
    if [ -f "$f" ] && diff -q "$bp_cmp_pull" "$f" >/dev/null 2>&1; then
      [ "$bp_cmp_pull" != "$bp" ] && rm -f "$bp_cmp_pull"
      echo "  ${C_DIM}same${C_RESET}  $f"
      continue
    fi
    echo
    echo "${C_BOLD}── $f${C_RESET}"
    if [ ! -f "$f" ]; then
      echo "  ${C_BLUE}new file${C_RESET} (blueprint adds it; project doesn't have it yet)"
    else
      # Diff against the substituted blueprint copy so the user sees
      # what would actually land in their tree, not noise from the
      # placeholder tokens.
      diff -u "$f" "$bp_cmp_pull" | head -60 || true
      echo "  ${C_DIM}(diff truncated at 60 lines — open the file to see all)${C_RESET}"
    fi
    [ "$bp_cmp_pull" != "$bp" ] && rm -f "$bp_cmp_pull"
    if [ "$auto_yes" -eq 0 ]; then
      # BUG-018 — degrade, do not die. `read </dev/tty` is unguarded in a
      # non-interactive context (CI, a spawned agent, a piped run), where it
      # fails with "No such device or address" AFTER the diff has been printed.
      # `drift` already handles this and is pinned by a test; pull differed from
      # it by accident rather than by decision.
      #
      # Refusing is the safe default: this is the branch where the operator has
      # NOT said yes, so proceeding would pull unreviewed content. It names
      # --yes rather than only reporting the problem.
      # `[ -r /dev/tty ]` is NOT sufficient and was my first attempt: the device
      # node exists and passes the readability test even when the process has no
      # controlling terminal — it is the OPEN that fails. So actually open it.
      # Redirection ORDER matters: they are processed left to right, so
      # `: </dev/tty 2>/dev/null` attempts the open BEFORE stderr is silenced
      # and bash's "No such device" message escapes to the real stderr — which
      # is exactly the noise this guard exists to remove. Silence stderr first.
      if ! : 2>/dev/null </dev/tty; then
        echo "  ${C_YELLOW}not interactive${C_RESET} — cannot prompt, so nothing is pulled."
        echo "  ${C_DIM}Re-run with --yes to accept without prompting, or run from a terminal.${C_RESET}"
        # REFUSED is not the same as NOTHING TO DO, and the exit code has to say
        # which. Acceptance testing rejected the first fix for exactly this: the
        # guard stopped the crash and printed the right advice, then returned 0
        # — so a script or agent that checked the status read "sync succeeded"
        # while the project stayed behind on every file.
        #
        # That is the defect BUG-016 fixed one field over (a partial pull
        # claiming a full sync) and the one BUG-011 fixed in a2bp (reporting
        # FILED with nothing filed). Same shape a third time: a command that
        # declines to act must not report success for declining.
        refused_no_tty=1
        break
      fi
      printf "  Pull this file? [y/N/q] "
      read -r ans </dev/tty
      case "$ans" in
        y|Y) ;;
        q|Q) echo "  ${C_YELLOW}aborted${C_RESET}"; break ;;
        *) echo "  ${C_DIM}skipped${C_RESET}"; continue ;;
      esac
    fi
    mkdir -p "$(dirname "$f")"
    if pull_file "$bp" "$f"; then
      echo "  ${C_GREEN}pulled${C_RESET} $f"
      pulled=$((pulled+1))
    else
      echo "  ${C_RED}skipped${C_RESET} $f (see warning above)"
    fi
  done

  echo
  if [ $pulled -gt 0 ]; then
    CURRENT_SHA=$(git -C "$BLUEPRINT_ROOT" rev-parse HEAD 2>/dev/null || echo "no-sha")
    # BUG-016 — bootstrap_sha means "this project is synced UP TO this commit".
    # A single-file pull does not make that true, and writing it anyway made
    # every later `drift` report "0 commits since sync" while the project was
    # still behind on every other managed file. The lie was durable: nothing
    # else recomputes that number, so the project looked current until someone
    # diffed by hand. linkedin-watcher-agent sat 18 commits behind this way.
    #
    # Only a FULL pull earns the update. A partial pull says so instead, which
    # is information the operator can act on rather than a silent omission.
    if [ "$partial" -eq 1 ]; then
      echo "${C_DIM}bootstrap_sha left unchanged — this was a partial pull, so the"
      echo "project is not synced to blueprint HEAD. Run 'blueprint pull' with no"
      echo "paths to sync fully.${C_RESET}"
    elif [ -f .blueprint-source ] && [ "$CURRENT_SHA" != "no-sha" ]; then
      sed -i.bak "s/^bootstrap_sha.*=.*/bootstrap_sha    = $CURRENT_SHA/" .blueprint-source
      rm -f .blueprint-source.bak
      echo "Updated .blueprint-source bootstrap_sha → $CURRENT_SHA"
    fi
    echo "${C_GREEN}✓ Pulled $pulled file(s). Review with 'git diff' and commit.${C_RESET}"
  else
    echo "${C_DIM}Nothing pulled.${C_RESET}"
  fi

  # Non-zero ONLY when we declined to act. "Nothing pulled because nothing
  # drifted" is a success and still returns 0 — conflating the two would make
  # every in-sync project look broken, which is the opposite failure and just as
  # useless to a caller.
  if [ "${refused_no_tty:-0}" -eq 1 ]; then
    return 7
  fi
}

# --- Subcommand: a2bp ---
#
# Files a back-propagation REQUEST against the blueprint's remote: a branch plus
# a pull request saying "this improvement proved itself downstream". It writes
# into no working tree, and it cannot land anything.
#
# It used to `cp` straight into $BLUEPRINT_ROOT. That made every derived project
# a writer to the generic blueprint, which is how BUG-002 and A-09 fanned out.
# The guard that was bolted on afterwards (A-07) is still here and still runs,
# but it is now advisory rather than the last line of defence: the last line is
# that a request has to be read and implemented by the blueprint owner.
#
# Plan: docs/doing/PLAN-A2BP-PR.md.
cmd_a2bp() {
  local libdir
  libdir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib"

  # Every one of these is REQUIRED, not best-effort. A missing helper must never
  # degrade to a weaker path — that is BUG-003's lesson (a guard that cannot run
  # is not a guard that passed), and here the weaker path is the direct write
  # this command exists to remove.
  local lib
  for lib in contamination.sh request.sh request-build.sh request-config.sh \
             request-inputs.sh request-file.sh; do
    [ -r "$libdir/$lib" ] || die "scripts/lib/$lib is missing — refusing to file a request without it"
    # shellcheck source=/dev/null
    . "$libdir/$lib"
  done

  local dry_run=0
  local files=()
  local arg
  for arg in "$@"; do
    case "$arg" in
      --dry-run) dry_run=1 ;;
      # --force is GONE, and refused loudly rather than ignored. It existed to
      # waive the guard and copy anyway — a decision that only made sense while
      # a2bp landed bytes in the blueprint. A request is read by a person before
      # anything lands, so there is nothing left for a waiver to buy: a finding
      # is either fixed, or marked with a justified `a2bp-allow: <why>`. If the
      # guard is wrong, that is a bug in contamination.sh and gets fixed as one.
      --force)
        die "--force is gone. a2bp files a request that a person reviews, so there is nothing to waive. Fix the finding, or mark the line with an inline 'a2bp-allow: <why it is safe>' comment. If the guard is wrong, that is a bug in scripts/lib/contamination.sh." ;;
      -*)        die "unknown option: $arg (usage: blueprint a2bp [--dry-run] FILE...)" ;;
      *)         files+=("$arg") ;;
    esac
  done
  [ "${#files[@]}" -gt 0 ] || die "usage: blueprint a2bp [--dry-run] FILE [FILE...]"

  bp_request_check_git_version || return "$BP_RC_FAILED"

  # --- configuration: WHERE this is filed (§8) ------------------------------
  local cfg_out
  cfg_out=$(bp_config_load ".blueprint-source") || return "$BP_RC_BLOCKED"
  eval "$cfg_out"

  # ${PWD##*/}, not $(basename): command substitution strips trailing newlines,
  # so a directory legally named with one was silently seen as a different
  # project (A-07 R6-F1).
  local proj_name=${PWD##*/}
  local root="$PWD"

  echo "${C_BOLD}Apply-to-blueprint — filing a request${C_RESET}"
  echo "  project:  $root  ${C_DIM}(name: $proj_name)${C_RESET}"
  echo "  remote:   $BP_CFG_REMOTE"
  echo "  branch:   $BP_CFG_BRANCH"
  [ "$dry_run" -eq 1 ] && echo "  ${C_DIM}--dry-run: reads the remote, writes nothing${C_RESET}"
  echo

  # --- input validation, before ANY remote contact (§5.1) -------------------
  # So a mistyped argument cannot leave a branch pushed and the run aborted.
  local managed_list
  managed_list=$(mktemp)
  printf '%s\n' "${MANAGED_FILES[@]}" > "$managed_list"
  local validated
  validated=$(bp_inputs_validate "$root" "$managed_list" "${files[@]}") || {
    rm -f "$managed_list"
    return "$BP_RC_BLOCKED"
  }
  rm -f "$managed_list"

  # --- scratch, cleaned on EVERY exit path ---------------------------------
  # BP_A2BP_SCRATCH is GLOBAL on purpose. As a `local` it is out of scope by the
  # time the EXIT trap runs — the function has already returned — so the handler
  # saw an empty value and silently cleaned nothing, leaking a bare clone per
  # run. The trap fires long after the frame that would have owned the variable.
  BP_A2BP_SCRATCH=$(bp_file_scratch) || return "$BP_RC_FAILED"
  # shellcheck disable=SC2317
  _a2bp_cleanup() {
    [ -n "${BP_A2BP_SCRATCH:-}" ] || return 0
    rm -rf "$BP_A2BP_SCRATCH" 2>/dev/null || \
      echo "${C_YELLOW}could not remove $BP_A2BP_SCRATCH — clean it up by hand${C_RESET}" >&2
    BP_A2BP_SCRATCH=""
  }
  trap _a2bp_cleanup EXIT INT TERM
  local scratch="$BP_A2BP_SCRATCH"
  local bare="$scratch/bare"

  # --- fetch the base (transport) ------------------------------------------
  local base
  base=$(bp_file_fetch_base "$scratch" "$BP_CFG_REMOTE" "$BP_CFG_BRANCH") || return "$BP_RC_FAILED"
  echo "  base:     $base"
  echo

  # --- base topology (§5.2) -------------------------------------------------
  local paths=()
  local line
  while IFS= read -r line; do
    [ -n "$line" ] && paths+=("${line%%:*}")
  done <<< "$validated"
  bp_build_validate_base "$bare" "$base" "${paths[@]}" || return "$BP_RC_BLOCKED"

  # --- stage + scan each file (A-07) ---------------------------------------
  # The guard aligns the project's file against the BASE's version, fetched
  # above — not against a local checkout, which may be arbitrarily stale. That
  # is a real improvement the PR flow gets for free: staging is now computed
  # against the bytes the request will actually be diffed against.
  local specs=() blocked=0
  local spec path mode staged basecopy
  while IFS= read -r spec; do
    [ -n "$spec" ] || continue
    path=${spec%%:*}
    mode=${spec#*:}

    basecopy="$scratch/base.$(printf '%s' "$path" | tr '/' '_')"
    bp_file_base_content "$bare" "$base" "$path" "$basecopy"

    staged="$scratch/staged.$(printf '%s' "$path" | tr '/' '_')"
    if _should_substitute "$path"; then
      # `|| stage_rc=$?`, never a bare call: under `set -e` a staging failure
      # would abort the run before the rejection below could be printed.
      local stage_rc=0
      contamination_stage "$root/$path" "$basecopy" "$proj_name" "$staged" || stage_rc=$?
      if [ "$stage_rc" -ne 0 ]; then
        echo "  ${C_RED}reject${C_RESET}  $path  (staging failed)"
        if [ "$stage_rc" -eq 3 ]; then
          echo "    ${C_DIM}Round-trip check failed: substituting the staged result does not${C_RESET}"
          echo "    ${C_DIM}reproduce your file. Refusing rather than risk altering content.${C_RESET}"
        else
          echo "    ${C_DIM}'diff' must support --unchanged-line-format/--old-line-format/${C_RESET}"
          echo "    ${C_DIM}--new-line-format (GNU diffutils). Install GNU diffutils and re-run.${C_RESET}"
        fi
        blocked=$((blocked+1))
        continue
      fi
    else
      cp "$root/$path" "$staged"
    fi

    # Scan the STAGED bytes — exactly what the request will carry. Scanning the
    # project's original would report the project name on every line.
    local findings has_block=0
    findings=$(contamination_scan "$staged" "$proj_name" "$path") || true
    printf '%s' "$findings" | grep -q '|BLOCK|' && has_block=1
    if [ -n "$findings" ]; then
      printf '%s\n' "$findings" | while IFS='|' read -r ln kind reason text; do
        local colour="$C_YELLOW"
        [ "$kind" = "BLOCK" ] && colour="$C_RED"
        echo "    ${colour}${kind}${C_RESET}  $path:$ln — $reason"
        echo "      ${C_DIM}${text}${C_RESET}"
      done
    fi
    if [ "$has_block" -eq 1 ]; then
      echo "  ${C_RED}reject${C_RESET}  $path  (contamination)"
      echo "    ${C_DIM}Fix the lines above, or mark a known-benign one with an inline${C_RESET}"
      echo "    ${C_DIM}'a2bp-allow: <why it is safe>' comment — the justification is required.${C_RESET}"
      blocked=$((blocked+1))
      continue
    fi

    specs+=("$path:$mode:$staged")
  done <<< "$validated"

  # A partial request is not a smaller request — it is a different one, filed
  # under a branch name that claims to describe what the operator asked for.
  if [ "$blocked" -gt 0 ]; then
    echo
    echo "${C_RED}✗ $blocked file(s) blocked — nothing filed.${C_RESET}"
    return "$BP_RC_BLOCKED"
  fi

  # --- drop no-ops (§5.1) ---------------------------------------------------
  local kept drop_rc=0
  kept=$(bp_inputs_drop_unchanged "$bare" "$base" "${specs[@]}") || drop_rc=$?
  if [ "$drop_rc" -eq 2 ]; then
    echo "${C_DIM}Nothing to request.${C_RESET}"
    return "$BP_RC_NOTHING"
  fi
  [ "$drop_rc" -eq 0 ] || return "$BP_RC_FAILED"
  specs=()
  while IFS= read -r spec; do [ -n "$spec" ] && specs+=("$spec"); done <<< "$kept"

  # --- identity + build ----------------------------------------------------
  local key ref commit
  key=$(bp_request_key "$BP_CFG_REMOTE" "$BP_CFG_BRANCH" "$base" "$proj_name" "${specs[@]}") \
    || return "$BP_RC_FAILED"
  ref=$(bp_request_ref "$proj_name" "$key") || return "$BP_RC_BLOCKED"
  commit=$(bp_build_request "$bare" "$base" "$ref" "$proj_name" "${specs[@]}") \
    || return "$BP_RC_FAILED"

  echo
  echo "${C_BOLD}Request${C_RESET}"
  echo "  branch:   $ref"
  echo "  commit:   $commit"
  echo "  files:    ${#specs[@]}"
  echo
  bp_request_hermetic git -C "$bare" --no-pager diff --stat "$base" "$commit" | sed 's/^/  /'
  echo

  if [ "$dry_run" -eq 1 ]; then
    echo "${C_DIM}--dry-run: nothing pushed. Full diff:${C_RESET}"
    echo "  ${C_DIM}git -C $bare diff $base $commit${C_RESET}"
    echo "${C_YELLOW}(the scratch clone is removed on exit; re-run without --dry-run to file)${C_RESET}"
    return "$BP_RC_OK"
  fi

  # --- re-check the base, then push (§6.4 step 10) -------------------------
  # Checking one ref and pushing another are not atomic. This closes the wide
  # window and leaves one of round-trip size; the residual is surfaced by
  # recording the base SHA in the PR body.
  local tip
  tip=$(bp_file_remote_tip "$BP_CFG_REMOTE" "$BP_CFG_BRANCH")
  if [ -n "$tip" ] && [ "$tip" != "$base" ]; then
    echo "${C_YELLOW}The blueprint moved while this request was being built — rebuilding once.${C_RESET}"
    echo "  ${C_DIM}was $base, now $tip${C_RESET}"
    base=$(bp_file_fetch_base "$scratch" "$BP_CFG_REMOTE" "$BP_CFG_BRANCH") || return "$BP_RC_FAILED"
    bp_build_validate_base "$bare" "$base" "${paths[@]}" || return "$BP_RC_BLOCKED"
    kept=$(bp_inputs_drop_unchanged "$bare" "$base" "${specs[@]}") || drop_rc=$?
    if [ "$drop_rc" -eq 2 ]; then
      echo "${C_DIM}Nothing to request against the new base.${C_RESET}"
      return "$BP_RC_NOTHING"
    fi
    specs=()
    while IFS= read -r spec; do [ -n "$spec" ] && specs+=("$spec"); done <<< "$kept"
    key=$(bp_request_key "$BP_CFG_REMOTE" "$BP_CFG_BRANCH" "$base" "$proj_name" "${specs[@]}")
    ref=$(bp_request_ref "$proj_name" "$key") || return "$BP_RC_BLOCKED"
    commit=$(bp_build_request "$bare" "$base" "$ref" "$proj_name" "${specs[@]}") || return "$BP_RC_FAILED"

    # Once. A second move means the blueprint is being actively pushed to, and
    # looping would spin until it happened to be quiet.
    tip=$(bp_file_remote_tip "$BP_CFG_REMOTE" "$BP_CFG_BRANCH")
    if [ -n "$tip" ] && [ "$tip" != "$base" ]; then
      echo "${C_RED}✗ The blueprint moved again. Re-run when it settles.${C_RESET}"
      return "$BP_RC_FAILED"
    fi
  fi

  bp_file_push "$bare" "$BP_CFG_REMOTE" "$ref" "$commit" || return "$BP_RC_FAILED"
  echo "${C_GREEN}✓ pushed $ref${C_RESET}"

  # --- the pull request ----------------------------------------------------
  local slug
  slug=$(printf '%s' "$BP_CFG_REMOTE" | sed -E 's#^git@[^:]+:##; s#^https?://[^/]+/##; s#\.git$##')

  if ! command -v gh >/dev/null 2>&1; then
    echo "${C_YELLOW}gh is not installed — the branch is pushed but no PR was opened.${C_RESET}"
    echo "  ${C_DIM}Open one from $ref against $BP_CFG_BRANCH.${C_RESET}"
    # BUG-011 / Codex F1 — FAILED (5), not PENDING (3), and this is the COMMON
    # path: most environments without gh reach here rather than the pr-create
    # failure below. The first fix corrected only that later branch, so the bug
    # survived exactly where it bites most. The message already says no PR was
    # opened; returning 3 contradicted it in the one field a script can read.
    return "$BP_RC_FAILED"
  fi

  # Query for an existing PR in ANY state first. Re-filing a request the owner
  # already closed is worse than failing: it re-spends the reviewer attention
  # this whole design protects, and reads as though the decision was not seen.
  local existing state url
  existing=$(bp_file_existing_pr "$slug" "$ref") || true
  # The literal "null" check is defence in depth, not belt-and-braces padding:
  # BUG-011 needed BOTH the probe and this guard to be wrong before it reached a
  # user. The probe is fixed (`.[0] // empty`); this makes the consumer refuse a
  # value it cannot act on, so a regression upstream degrades to "no PR found"
  # — which re-files, an annoyance — rather than to "already open: null", which
  # silently reports success and files nothing.
  if [ -n "$existing" ] && [ "$existing" != "	" ] \
     && [ "$existing" != "null	null" ] && [ "${existing%%	*}" != "null" ]; then
    state=${existing%%	*}
    url=${existing#*	}
    case "$state" in
      CLOSED|MERGED)
        echo "${C_YELLOW}A PR for this exact request already exists and is $state:${C_RESET}"
        echo "  $url"
        echo "  ${C_DIM}Not re-filing. If the decision should be revisited, say so there.${C_RESET}"
        return "$BP_RC_PENDING" ;;
      *)
        echo "${C_GREEN}✓ request already open:${C_RESET} $url"
        return "$BP_RC_PENDING" ;;
    esac
  fi

  local body
  body=$(bp_file_pr_body "$proj_name" "$base" "$BP_CFG_REMOTE" "$BP_CFG_BRANCH" "${specs[@]}")
  url=$(bp_request_transport_env gh pr create --repo "$slug" \
          --base "$BP_CFG_BRANCH" --head "$ref" \
          --title "a2bp: ${#specs[@]} file(s) from $proj_name" \
          --body "$body" 2>&1) || {
    echo "${C_YELLOW}The branch is pushed, but opening the PR failed:${C_RESET}"
    printf '%s\n' "$url" | sed 's/^/  /'
    echo "  ${C_DIM}Open one by hand from $ref, or re-run — the branch will be adopted.${C_RESET}"
    # BUG-011 — FAILED (5), not PENDING (3). 3 is a promise that a reviewer now
    # has something to look at; nothing was filed here, and a caller that reads
    # 3 as "the request is in" has been told something false. A pushed branch
    # with no PR is an operational failure, which is exactly what 5 means.
    return "$BP_RC_FAILED"
  }

  # BUG-011 / Codex R2-F1 — THE THIRD no-PR path. `gh pr create` exiting zero is
  # not proof a PR exists: it can print nothing, `null`, or a warning, and this
  # code then announced "request filed" and returned 3 on the strength of an
  # exit status alone. That is the same boundary already defended for
  # bp_file_existing_pr — when the OUTPUT is the evidence the caller relies on,
  # a success status does not substitute for it.
  case "$url" in
    https://*/pull/*|https://*/pulls/*) ;;
    *)
      echo "${C_YELLOW}gh reported success but returned no usable PR URL:${C_RESET}"
      printf '%s\n' "${url:-<empty>}" | sed 's/^/  /'
      echo "  ${C_DIM}The branch is pushed. Open a PR from $ref against $BP_CFG_BRANCH.${C_RESET}"
      return "$BP_RC_FAILED" ;;
  esac

  echo "${C_GREEN}✓ request filed:${C_RESET} $url"
  echo
  echo "${C_BOLD}This is a REQUEST, not a delivery.${C_RESET}"
  echo "${C_DIM}  The blueprint owner implements it upstream — merging as-is, adapting,${C_RESET}"
  echo "${C_DIM}  or rewriting — and decides which ripples travel with it. Merging as-is${C_RESET}"
  echo "${C_DIM}  is legitimate BECAUSE someone judged it trivial; that judgement is the${C_RESET}"
  echo "${C_DIM}  step that must not be skipped. See docs/A2BP_PLAYBOOK.md.${C_RESET}"

  # Non-zero on purpose: filed is not landed, and a script must not be able to
  # read "request opened" as "the blueprint now has this".
  return "$BP_RC_PENDING"
}

# --- Subcommand: prs ---
# What is currently asked of the blueprint owner.
cmd_prs() {
  local libdir
  libdir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib"
  [ -r "$libdir/request-config.sh" ] || die "scripts/lib/request-config.sh is missing"
  # shellcheck source=scripts/lib/request-config.sh
  . "$libdir/request-config.sh"

  local cfg_out
  cfg_out=$(bp_config_load ".blueprint-source") || return 1
  eval "$cfg_out"

  local slug
  slug=$(printf '%s' "$BP_CFG_REMOTE" | sed -E 's#^git@[^:]+:##; s#^https?://[^/]+/##; s#\.git$##')

  command -v gh >/dev/null 2>&1 || die "gh is not installed — cannot list requests"

  echo "${C_BOLD}Open a2bp requests on $slug${C_RESET}"
  echo

  local prs rc=0
  prs=$(gh pr list --repo "$slug" --state open --limit 100 \
        --json number,headRefName,title,createdAt,isDraft,url \
        --jq '.[] | select(.headRefName | startswith("a2bp/")) |
              "\(.number)\t\(.headRefName)\t\(.createdAt)\t\(.isDraft)\t\(.url)"' 2>/dev/null) || rc=$?

  if [ "$rc" -ne 0 ]; then
    # An API failure must never print an empty list. "No open requests" and
    # "I could not find out" are different answers, and only one of them means
    # there is nothing to do.
    echo "${C_RED}✗ Could not query GitHub — this list is INCOMPLETE, not empty.${C_RESET}"
    return 1
  fi

  if [ -z "$prs" ]; then
    echo "${C_DIM}No open a2bp requests.${C_RESET}"
  else
    local num ref created draft url project
    while IFS=$'\t' read -r num ref created draft url; do
      [ -n "$num" ] || continue
      # a2bp/<project>/<digest> — project is at a fixed position, which is why
      # bp_request_ref refuses a project name containing '/'.
      project=$(printf '%s' "$ref" | cut -d/ -f2)
      printf '  #%-5s %-20s %s' "$num" "$project" "${created%%T*}"
      [ "$draft" = "true" ] && printf '  %s[draft]%s' "$C_YELLOW" "$C_RESET"
      printf '\n    %s%s%s\n' "$C_DIM" "$url" "$C_RESET"
    done <<< "$prs"
  fi

  # Branches pushed with no PR — the recoverable half of a failed filing, and
  # invisible in any PR listing.
  echo
  local orphans
  orphans=$(bp_request_transport_env git ls-remote --heads "$BP_CFG_REMOTE" 'refs/heads/a2bp/*' 2>/dev/null \
            | awk '{print $2}' | sed 's#^refs/heads/##') || true
  if [ -n "$orphans" ]; then
    local open_refs
    open_refs=$(printf '%s\n' "$prs" | cut -f2)
    local o found=0
    while IFS= read -r o; do
      [ -n "$o" ] || continue
      printf '%s\n' "$open_refs" | grep -qxF -- "$o" && continue
      [ "$found" -eq 0 ] && echo "${C_YELLOW}Pushed branches with no open PR:${C_RESET}"
      found=1
      echo "  ${C_DIM}$o${C_RESET}"
    done <<< "$orphans"
    [ "$found" -eq 1 ] && echo "  ${C_DIM}(a closed PR, or a filing that failed after the push)${C_RESET}"
  fi
}

# --- Subcommand: help ---
cmd_help() {
  # The range must cover the header block above, which grew when a2bp became a
  # request. A hardcoded end line silently truncates help the moment the header
  # changes length, so it is derived from the last header line instead.
  local last
  last=$(grep -n '^# Or symlink it:' "$0" | head -1 | cut -d: -f1)
  sed -n "2,$((last + 1))p" "$0" | sed 's/^# //; s/^#//'
}

# --- Dispatch ---
SUBCMD="${1:-help}"
shift || true
case "$SUBCMD" in
  drift)  cmd_drift "$@" ;;
  pull)   cmd_pull "$@" ;;
  # No `push` alias any more. It described what the command used to do — write
  # into the blueprint — and the whole point of this change is that it no longer
  # can. Left as an explicit refusal rather than removed silently, so anyone
  # with it in a script or in muscle memory is told what replaced it.
  a2bp)   cmd_a2bp "$@" ;;
  push)   die "'blueprint push' is gone: a2bp files a REQUEST against the blueprint remote, it does not push into the blueprint. Use 'blueprint a2bp FILE...'" ;;
  prs)    cmd_prs "$@" ;;
  files|list) cmd_files "$@" ;;
  help|--help|-h) cmd_help ;;
  *) die "unknown subcommand: $SUBCMD (try 'blueprint help')" ;;
esac
